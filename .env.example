# ============================================================
# ALCHEMYSTERY — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase (required)
# Find these in your Supabase project dashboard > Settings > API
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only, NEVER prefix with NEXT_PUBLIC_
# Used only in lib/supabase/admin.ts for privileged server operations
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
